<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProjectStudio.Views.SettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28" Spacing="20">
<TextBlock Classes="h1" Text="Настройки" />
<Border Classes="card">
  <StackPanel>
    <TextBlock Classes="h2" Text="Оформление" Margin="0,0,0,4" />
<Grid ColumnDefinitions="*,Auto" Margin="0,10">
  <StackPanel Spacing="2" VerticalAlignment="Center">
    <TextBlock Classes="body" FontWeight="SemiBold" Text="Тёмная тема" />
    <TextBlock Classes="muted" Text="Переключение между светлым и тёмным оформлением" />
  </StackPanel>
  <ToggleSwitch Grid.Column="1" Name="ThemeSwitch" OnContent="" OffContent="" IsChecked="false" IsCheckedChanged="Theme_Changed" />
</Grid>
  </StackPanel>
</Border>
<Border Classes="card">
  <StackPanel>
    <TextBlock Classes="h2" Text="Уведомления" Margin="0,0,0,4" />
<Grid ColumnDefinitions="*,Auto" Margin="0,10">
  <StackPanel Spacing="2" VerticalAlignment="Center">
    <TextBlock Classes="body" FontWeight="SemiBold" Text="Уведомления по почте" />
    <TextBlock Classes="muted" Text="Получать сводку по проектам" />
  </StackPanel>
  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="true" />
</Grid>
<Border Classes="sep" />
<Grid ColumnDefinitions="*,Auto" Margin="0,10">
  <StackPanel Spacing="2" VerticalAlignment="Center">
    <TextBlock Classes="body" FontWeight="SemiBold" Text="Напоминания о сроках" />
    <TextBlock Classes="muted" Text="Сообщать о приближении дедлайнов" />
  </StackPanel>
  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="true" />
</Grid>
<Border Classes="sep" />
<Grid ColumnDefinitions="*,Auto" Margin="0,10">
  <StackPanel Spacing="2" VerticalAlignment="Center">
    <TextBlock Classes="body" FontWeight="SemiBold" Text="Звуковые сигналы" />
    <TextBlock Classes="muted" Text="Воспроизводить звук при новых событиях" />
  </StackPanel>
  <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="false" />
</Grid>
  </StackPanel>
</Border>
<Border Classes="card">
  <StackPanel Spacing="10">
    <TextBlock Classes="h2" Text="Язык" />
    <ComboBox SelectedIndex="0" MinWidth="220">
      <ComboBoxItem Content="Русский" />
      <ComboBoxItem Content="English" />
    </ComboBox>
  </StackPanel>
</Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
