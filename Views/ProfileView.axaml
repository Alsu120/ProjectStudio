<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ProjectStudio.Views.ProfileView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28" Spacing="20">
<TextBlock Classes="h1" Text="Личный кабинет" />
<Border Classes="card">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
    <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource AccentBrush}">
      <TextBlock Name="InitialsText" Foreground="White" FontSize="30" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
      <TextBlock Name="FullNameText" Classes="h1" TextWrapping="Wrap" />
      <TextBlock Name="RoleText" Classes="muted" />
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
        <Button Classes="primary" Content="Редактировать профиль" />
        <Button Classes="ghost" Content="Сменить пароль" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Border>

<Grid ColumnDefinitions="*,320" ColumnSpacing="16">
  <Border Classes="card">
    <StackPanel Spacing="14">
      <TextBlock Classes="h2" Text="Личные данные" />
<StackPanel Spacing="6">
  <TextBlock Classes="muted" Text="ФИО" />
  <TextBox Name="FullNameBox" IsReadOnly="True" />
</StackPanel>
<StackPanel Spacing="6">
  <TextBlock Classes="muted" Text="Должность" />
  <TextBox Name="RoleBox" IsReadOnly="True" />
</StackPanel>
<StackPanel Spacing="6">
  <TextBlock Classes="muted" Text="Email" />
  <TextBox Name="EmailBox" IsReadOnly="True" />
</StackPanel>
<StackPanel Spacing="6">
  <TextBlock Classes="muted" Text="Телефон" />
  <TextBox Name="PhoneBox" IsReadOnly="True" />
</StackPanel>
    </StackPanel>
  </Border>
  <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
    <StackPanel Spacing="18">
      <TextBlock Classes="h2" Text="Статистика" />
<StackPanel Spacing="2" HorizontalAlignment="Center">
  <TextBlock Classes="big" Text="12" HorizontalAlignment="Center" />
  <TextBlock Classes="muted" Text="Проектов" HorizontalAlignment="Center" />
</StackPanel>
<Border Classes="sep" />
<StackPanel Spacing="2" HorizontalAlignment="Center">
  <TextBlock Classes="big" Text="48" HorizontalAlignment="Center" />
  <TextBlock Classes="muted" Text="Задач в работе" HorizontalAlignment="Center" />
</StackPanel>
<Border Classes="sep" />
<StackPanel Spacing="2" HorizontalAlignment="Center">
  <TextBlock Classes="big" Text="5" HorizontalAlignment="Center" />
  <TextBlock Classes="muted" Text="Просрочено" HorizontalAlignment="Center" />
</StackPanel>
    </StackPanel>
  </Border>
</Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
